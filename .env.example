# Supabase
DATABASE_URL="postgres://[USER]:[PASSWORD]@[HOST]:6543/[DB]?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgres://[USER]:[PASSWORD]@[HOST]:5432/[DB]"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""


# AI Agent
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""


# Alchemy RPC
ALCHEMY_RPC_URL_ROBINHOOD_MAINNET=""
ALCHEMY_RPC_URL_ROBINHOOD_TESTNET=""
ALCHEMY_RPC_URL_ETHEREUM=""
ALCHEMY_RPC_URL_ETHEREUM_SEPOLIA=""
ALCHEMY_RPC_URL_POLYGON=""


# Blockscout API
# One shared API key for all chains:
BLOCKSCOUT_API_KEY_MAINNET=""
BLOCKSCOUT_API_URL_ROBINHOOD_MAINNET="https://robinhoodchain.blockscout.com/api/v2"
BLOCKSCOUT_API_URL_ROBINHOOD_TESTNET="https://explorer.testnet.chain.robinhood.com/api/v2"
BLOCKSCOUT_API_URL_ETHEREUM="https://eth.blockscout.com/api/v2"
BLOCKSCOUT_API_URL_ETHEREUM_SEPOLIA="https://eth-sepolia.blockscout.com/api/v2"
BLOCKSCOUT_API_URL_POLYGON="https://polygon.blockscout.com/api/v2"


# Uniswap Trading API
# Get a key: https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=""


# Encryption
WALLET_ENCRYPTION_KEY=""


# Max ms agent tools wait for tx receipt before returning status=pending (default 45000)
TX_RECEIPT_TIMEOUT_MS=45000


# LLM usage metrics & soft quotas
USAGE_ENFORCE=true
USAGE_ESTIMATE_WHEN_MISSING=true
USAGE_LLM_REQUESTS_PER_MINUTE=20
USAGE_LLM_REQUESTS_PER_DAY=200
USAGE_LLM_TOKENS_PER_DAY=2000000
USAGE_LLM_TOKENS_SOFT_RATIO=0.8


# Base tokens for system prompt + tool schemas when estimating (OpenAI models without usage)
USAGE_ESTIMATE_BASE_INPUT_TOKENS=1000


# Coingecko
COINGECKO_API_KEY=""


# Redis / Vercel KV
REDIS_URL=""
